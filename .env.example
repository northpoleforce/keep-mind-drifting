# Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Evermemos (official Python SDK)
# Verified endpoint example
EVERMEMOS_BASE_URL=https://api.evermind.ai
EVERMEMOS_API_KEY=replace_me
EVERMEMOS_SENDER_NAME=Evermind Demo
EVERMEMOS_TOPIC_SENDER_NAME=Evermind Topic Detector
EVERMEMOS_TIMEOUT_SECONDS=10
EVERMEMOS_MAX_RETRIES=2
EVERMEMOS_CONSISTENCY_RETRIES=3
EVERMEMOS_CONSISTENCY_DELAY_MS=600

# LLM (OpenAI-compatible provider, default: Kimi)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=replace_me
LLM_MODEL=kimi-k2-turbo-preview
LLM_TEMPERATURE=0.6
LLM_MAX_COMPLETION_TOKENS=512
LLM_USE_PROMPT_CACHE_KEY=false
LLM_STRIP_THINK_TAGS=true
LLM_SYSTEM_PROMPT=你是 Evermind 的 AI 助手。请基于上下文给出清晰、可执行、简洁的回答。

# MiniMax quick switch example:
# LLM_PROVIDER=minimax
# LLM_BASE_URL=https://api.minimax.io/v1
# LLM_MODEL=MiniMax-M2.5

# Retrieval weights
RETRIEVAL_CACHE_WEIGHT=0.6
RETRIEVAL_MEMORY_WEIGHT=0.4

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
